# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/pii_tokenization"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# FPE Encryption
FPE_KEY="0123456789ABCDEF0123456789ABCDEF"  # 32 byte hex key untuk AES-256

# Server
PORT=5000
NODE_ENV=development

# Redis (opsional untuk queue)
REDIS_URL="redis://localhost:6379"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
